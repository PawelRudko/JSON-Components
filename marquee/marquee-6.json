"load\", () => {\n  const marquee = document.querySelector(\".logo-marquee\");\n  const lines = marquee ? marquee.querySelectorAll(\".logo-marquee-line\") : [];\n  const tweens = [];\n\n  lines.forEach((line) => {\n    const distance = line.scrollWidth;\n    gsap.set(line, { x: 0 });\n\n    const t = gsap.to(line, {\n      x: -distance,\n      duration: 15,\n      ease: \"none\",\n      repeat: -1,\n      modifiers: {\n        x: gsap.utils.unitize((x) => gsap.utils.wrap(-distance, 0, parseFloat(x))),\n      },\n    });\n\n    tweens.push(t);\n  });\n\n  marquee.addEventListener(\"mouseenter\", () => tweens.forEach((t) => t.pause()));\n  marquee.addEventListener(\"mouseleave\", () => tweens.forEach((t) => t.resume()));\n});\n</script>","data":{"search":{"exclude":true},"embed":{"meta":{"html":"<script>\nwindow.addEventListener(\"load\", () => {\n  const marquee = document.querySelector(\".logo-marquee\");\n  const lines = marquee ? marquee.querySelectorAll(\".logo-marquee-line\") : [];\n  const tweens = [];\n\n  lines.forEach((line) => {\n    const distance = line.scrollWidth;\n    gsap.set(line, { x: 0 });\n\n    const t = gsap.to(line, {\n      x: -distance,\n      duration: 15,\n      ease: \"none\",\n      repeat: -1,\n      modifiers: {\n        x: gsap.utils.unitize((x) => gsap.utils.wrap(-distance, 0, parseFloat(x))),\n      },\n    });\n\n    tweens.push(t);\n  });\n\n  marquee.addEventListener(\"mouseenter\", () => tweens.forEach((t) => t.pause()));\n  marquee.addEventListener(\"mouseleave\", () => tweens.forEach((t) => t.resume()));\n});\n</script>","div":false,"script":true,"compilable":false,"iframe":false},"type":"html"},"insideRTE":false,"devlink":{"runtimeProps":{},"slot":""},"displayName":"","attr":{"id":""},"xattr":[],"visibility":{"conditions":[]}}}],"styles":[{"_id":"15d23ed0-fca2-03b4-9d63-1a0e2c49ff82","fake":false,"type":"class","name":"Section","namespace":"","comb":"","styleLess":"display: flex; height: 100vh; flex-direction: column; justify-